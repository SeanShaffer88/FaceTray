<Application x:Class="FaceTray.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Product-family tokens (black/red), used by the Settings and Login
             windows. The ticker popup intentionally uses Facebook's palette
             instead (SEAN, 2026-10-23) — see TickerWindow. -->
        <SolidColorBrush x:Key="BgBrush" Color="#101010"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#1A1A1C"/>
        <SolidColorBrush x:Key="HairlineBrush" Color="#242424"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#E5484D"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#A8A8A8"/>
    </Application.Resources>
</Application>
