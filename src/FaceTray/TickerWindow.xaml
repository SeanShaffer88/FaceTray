<Window x:Class="FaceTray.TickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FaceTray — Notifications"
        Width="380" MaxHeight="660" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        ShowActivated="True" Topmost="True"
        AllowsTransparency="True" Background="Transparent"
        AutomationProperties.Name="Facebook notifications ticker">
    <!-- Facebook's own menu look (SEAN, 2026-10-23) is the default palette,
         applied from code so v0.2.0's Light / Follow-Windows themes and the
         text-size setting can restyle the same layout. -->
    <Border x:Name="RootBorder" Background="#242526" CornerRadius="8" BorderBrush="#3A3B3C" BorderThickness="1" Padding="8,10,8,10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.45" Color="Black"/>
        </Border.Effect>
        <DockPanel>
            <!-- Header -->
            <Grid DockPanel.Dock="Top" Margin="4,0,0,2">
                <TextBlock x:Name="TitleText" Text="Notifications" FontSize="24" FontWeight="Bold" Foreground="#E4E6EB"
                           VerticalAlignment="Center"/>
                <Button x:Name="MenuButton" HorizontalAlignment="Right" Width="36" Height="36"
                        Background="#3A3B3C" Foreground="#E4E6EB" BorderThickness="0" Cursor="Hand"
                        FontSize="16" Content="···" AutomationProperties.Name="FaceTray menu"
                        Click="OnMenuButton">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="18">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Search -->
            <Border x:Name="SearchBorder" DockPanel.Dock="Top" Margin="4,4,4,2" CornerRadius="6"
                    Background="#3A3B3C" Padding="8,5">
                <Grid>
                    <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                             Foreground="#E4E6EB" FontSize="13.5" CaretBrush="#E4E6EB"
                             AutomationProperties.Name="Search notifications"
                             TextChanged="OnSearchChanged"/>
                    <TextBlock x:Name="SearchHint" Text="Search notifications" FontSize="13.5"
                               Foreground="#B0B3B8" IsHitTestVisible="False" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Filter pills -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,4,0,6">
                <Button x:Name="AllPill" Padding="12,4" Margin="0,0,6,0" Cursor="Hand"
                        Content="All" AutomationProperties.Name="Show all notifications" Click="OnAllPill">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="14">
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="UnreadPill" Padding="12,4" Cursor="Hand"
                        Content="Unread" AutomationProperties.Name="Show unread notifications only" Click="OnUnreadPill">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="14">
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBlock x:Name="RefreshingText" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="#B0B3B8" FontSize="12" Text="Refreshing…" Visibility="Collapsed"/>
            </StackPanel>

            <!-- Extraction-health warning (v0.2.0) -->
            <Border x:Name="HealthBanner" DockPanel.Dock="Top" Visibility="Collapsed"
                    Margin="4,0,4,6" CornerRadius="6" Padding="10,7" Background="#4A3A12">
                <TextBlock x:Name="HealthBannerText" TextWrapping="Wrap" FontSize="12.5" Foreground="#F5C542"
                           Text="Facebook's layout may have changed — some notifications might be missing."/>
            </Border>

            <!-- Session checkpoint banner (v0.3.0): shown above cached rows -->
            <Border x:Name="SessionBanner" DockPanel.Dock="Top" Visibility="Collapsed"
                    Margin="4,0,4,6" CornerRadius="6" Padding="10,7" Background="#4A3A12">
                <StackPanel>
                    <TextBlock x:Name="SessionBannerText" TextWrapping="Wrap" FontSize="12.5" Foreground="#F5C542"
                               Text="Facebook needs you to confirm it's you before FaceTray can keep reading notifications."/>
                    <Button x:Name="SessionConfirmButton" Margin="0,8,0,0" Padding="12,5" HorizontalAlignment="Left" Cursor="Hand"
                            Background="#2D88FF" Foreground="White" BorderThickness="0" FontSize="13"
                            Content="Confirm it's you" AutomationProperties.Name="Confirm it is you on Facebook"
                            Click="OnSignIn"/>
                </StackPanel>
            </Border>

            <!-- Footer stack: undo bar + staleness + Show more + the Facebook page button -->
            <StackPanel DockPanel.Dock="Bottom">
                <Border x:Name="UndoBar" Visibility="Collapsed" Margin="0,8,0,0" CornerRadius="6"
                        Padding="10,6" Background="#3A3B3C">
                    <Grid>
                        <TextBlock x:Name="UndoText" Text="All marked read." Foreground="#E4E6EB" FontSize="13"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="UndoButton" HorizontalAlignment="Right" Padding="10,2" Cursor="Hand"
                                Background="Transparent" Foreground="#2D88FF" BorderThickness="0" FontSize="13"
                                Content="Undo" AutomationProperties.Name="Undo mark all read"
                                Click="OnUndoClicked"/>
                    </Grid>
                </Border>
                <TextBlock x:Name="StalenessLine" Margin="4,8,4,0" FontSize="12" Foreground="#B0B3B8" Text=""/>
                <Button x:Name="ShowMoreButton" Margin="0,8,0,0" Padding="0,7" Cursor="Hand" Visibility="Collapsed"
                        Background="#3A3B3C" Foreground="#E4E6EB" BorderThickness="0" FontSize="13"
                        Content="Show more" AutomationProperties.Name="Show more notifications"
                        Click="OnShowMore">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="FooterButton" Margin="0,8,0,0" Padding="0,9" Cursor="Hand"
                        Background="#3A3B3C" Foreground="#FFFFFF" BorderThickness="0" FontSize="14"
                        Content="See previous notifications" AutomationProperties.Name="See previous notifications on Facebook"
                        Click="OnFooter">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <!-- State panels + list -->
            <Grid>
                <StackPanel x:Name="SignInPanel" Visibility="Collapsed" Margin="8,18" VerticalAlignment="Top">
                    <TextBlock x:Name="SignInText" TextWrapping="Wrap" Foreground="#E4E6EB" FontSize="14"
                               Text="You're not signed in to Facebook in FaceTray yet."/>
                    <Button x:Name="SignInButton" Margin="0,12,0,0" Padding="14,7" HorizontalAlignment="Left" Cursor="Hand"
                            Background="#2D88FF" Foreground="White" BorderThickness="0"
                            Content="Sign in to Facebook" AutomationProperties.Name="Sign in to Facebook"
                            Click="OnSignIn"/>
                </StackPanel>

                <TextBlock x:Name="LoadingPanel" Visibility="Collapsed" Margin="8,18" VerticalAlignment="Top"
                           Foreground="#B0B3B8" FontSize="14" Text="Loading your notifications…"/>

                <TextBlock x:Name="CaughtUpPanel" Visibility="Collapsed" Margin="8,18" VerticalAlignment="Top"
                           Foreground="#E4E6EB" FontSize="14" Text="You're all caught up."/>

                <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" Margin="8,18" VerticalAlignment="Top">
                    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#E4E6EB" FontSize="14"/>
                    <Button x:Name="RetryButton" Margin="0,12,0,0" Padding="14,7" HorizontalAlignment="Left" Cursor="Hand"
                            Background="#3A3B3C" Foreground="White" BorderThickness="0"
                            Content="Retry" AutomationProperties.Name="Retry loading notifications"
                            Click="OnRetry"/>
                </StackPanel>

                <StackPanel x:Name="CheckpointPanel" Visibility="Collapsed" Margin="8,18" VerticalAlignment="Top">
                    <TextBlock x:Name="CheckpointText" TextWrapping="Wrap" Foreground="#E4E6EB" FontSize="14"
                               Text="Facebook needs you to confirm it's you. Confirm in the sign-in window, and FaceTray will pick up right where it left off."/>
                    <Button x:Name="CheckpointButton" Margin="0,12,0,0" Padding="14,7" HorizontalAlignment="Left" Cursor="Hand"
                            Background="#2D88FF" Foreground="White" BorderThickness="0"
                            Content="Confirm it's you" AutomationProperties.Name="Confirm it is you on Facebook"
                            Click="OnSignIn"/>
                </StackPanel>

                <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Auto" MaxHeight="470">
                    <StackPanel x:Name="ItemsPanel"/>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
</Window>
